{
  "name": "unraid-desktop-widget",
  "version": "1.10.4",
  "description": "Windows 桌面挂件 —— 支持多服务器（Unraid / Proxmox VE / Synology DSM / 飞牛 fnOS）监控与管理容器、虚拟机",
  "main": "src/main.js",
  "author": "RoykingH",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "node tools/mock-server.js",
    "mock:pve": "node tools/mock-proxmox.js",
    "mock:dsm": "node tools/mock-dsm.js",
    "mock:fnos": "node tools/mock-fnos.js",
    "probe:fnos": "node tools/probe-fnos.js",
    "icon": "node tools/gen-icon.js",
    "selftest": "node tools/selftest.js && node tools/selftest-proxmox.js && node tools/selftest-dsm.js && node tools/selftest-fnos.js",
    "selftest:unraid": "node tools/selftest.js",
    "selftest:pve": "node tools/selftest-proxmox.js",
    "selftest:dsm": "node tools/selftest-dsm.js",
    "selftest:fnos": "node tools/selftest-fnos.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "top.nasassistant.widget",
    "productName": "NasAssistant",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-x64-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NAS桌面助手"
    },
    "portable": {
      "artifactName": "${productName}-${version}-x64-Portable.${ext}"
    }
  }
}
